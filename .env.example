# Optional. These are the defaults.
# If you change any of them, change DATABASE_URL in backend/.env to match.
# Postgres only reads the user, password and database name when it creates the volume.
# The Docker app puts the user and password in a URL, so keep to letters, digits, - and _.
# POSTGRES_USER=context_lens
# POSTGRES_PASSWORD=context_lens
# POSTGRES_DB=context_lens
# POSTGRES_PORT=5432

# For the whole app in Docker (docker compose --profile app up -d --build --wait).
# Running the backend without Docker reads backend/.env instead.

# Required.
GEMINI_API_KEY=

# Required. The password to log in to the app: Docker won't start it without one.
# Make it long and random, such as the output of: openssl rand -base64 24
ACCESS_PASSWORD=

# Optional. The port the app is served on, on this machine only: http://127.0.0.1:8080
# APP_PORT=8080

# Set it to true when the app is served over HTTPS, so the cookie is sent only there.
# SECURE_COOKIES=false

# Optional too: the model and limit settings in backend/.env.example, such as GEMINI_MODEL.
