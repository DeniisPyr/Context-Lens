GEMINI_API_KEY=

# Set a password before anyone else can reach the app. Without one there is no login,
# so anyone who can reach the API can read the documents and spend the Gemini credits.
# ACCESS_PASSWORD=

# Set it to true when the app is served over HTTPS, so the cookie is sent only there.
# SECURE_COOKIES=false

# Optional. These are the defaults.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_TIMEOUT_SECONDS=60
# MAX_UPLOAD_BYTES=1000000
# MAX_DOCUMENTS_PER_DATASET=100
# CHUNKS_PER_QUESTION=8
# DATABASE_URL=postgresql+psycopg://context_lens:context_lens@localhost:5432/context_lens
